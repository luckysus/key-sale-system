# 复制为服务器上的环境变量文件后再改值；不要把真实密钥提交或发给别人。
APP_SECRET=please-change-to-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=please-change-admin-password
COOKIE_SECURE=1
ENABLE_API_DOCS=0
TRUSTED_PROXIES=127.0.0.1

# 只允许这两个正式域名和本机访问 FastAPI；部署时替换为你的域名。
ALLOWED_HOSTS=admin.example.com,buyer.example.com,localhost,127.0.0.1
ADMIN_HOSTS=admin.example.com
BUYER_HOSTS=buyer.example.com

# sub2api 默认只允许本机地址，避免后台被滥用成任意内网探测。
ALLOWED_SUB2API_HOSTS=127.0.0.1,localhost

# 后台登录失败锁定：同一 IP+用户名连续失败 5 次，锁 15 分钟。
LOGIN_LOCK_ATTEMPTS=5
LOGIN_LOCK_SECONDS=900

# 买家兑换防刷：Redis 必须只监听可信本机或内网，并设置合理的内存策略。
REDIS_URL=redis://127.0.0.1:6379/0
REDEEM_IP_LIMIT=20
REDEEM_IP_WINDOW_SECONDS=60
REDEEM_CARD_LIMIT=5
REDEEM_CARD_WINDOW_SECONDS=300
REDEEM_FAILURE_THRESHOLD=5
REDEEM_FAILURE_WINDOW_SECONDS=600
REDEEM_CONCURRENCY=10
REDEEM_PREPARE_TIMEOUT_SECONDS=180
REDEEM_LEASE_SECONDS=210
